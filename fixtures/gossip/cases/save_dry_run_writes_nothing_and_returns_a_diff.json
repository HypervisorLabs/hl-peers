{
  "name": "save_dry_run_writes_nothing_and_returns_a_diff",
  "description": "dry_run renders the unified diff against what is on disk and writes nothing.",
  "input_config": {
    "chain": "Mainnet",
    "root_node_ips": [
      {
        "Ip": "192.0.2.10"
      }
    ],
    "try_new_peers": true
  },
  "operations": [
    {
      "op": "save",
      "args": [
        "$TMPDIR/override_gossip_config.json"
      ]
    },
    {
      "op": "add_root_ip",
      "args": [
        "192.0.2.99"
      ]
    },
    {
      "op": "save",
      "args": [
        "$TMPDIR/override_gossip_config.json"
      ],
      "opts": {
        "dry_run": true
      }
    }
  ],
  "expect": {
    "value": {
      "written": false,
      "changed": true
    },
    "warnings": [],
    "diff_contains": [
      "192.0.2.99"
    ],
    "file_after": {
      "path": "$TMPDIR/override_gossip_config.json",
      "json_text": "{\n  \"chain\": \"Mainnet\",\n  \"root_node_ips\": [\n    {\n      \"Ip\": \"192.0.2.10\"\n    }\n  ],\n  \"try_new_peers\": true\n}\n"
    }
  }
}
