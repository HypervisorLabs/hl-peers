{
  "name": "split_client_blocks_false_removes_the_key",
  "description": "The node's serializer omits it when false, so the setter removes it.",
  "input_config": {
    "chain": "Mainnet",
    "root_node_ips": [
      {
        "Ip": "192.0.2.10"
      }
    ],
    "try_new_peers": false,
    "split_client_blocks": true
  },
  "operations": [
    {
      "op": "set_split_client_blocks",
      "args": [
        false
      ]
    }
  ],
  "expect": {
    "json_text": "{\n  \"chain\": \"Mainnet\",\n  \"root_node_ips\": [\n    {\n      \"Ip\": \"192.0.2.10\"\n    }\n  ],\n  \"try_new_peers\": false\n}\n",
    "warnings": []
  }
}
