{
  "name": "validate_malformed_ipv4_is_refused",
  "description": "999.0.2.10 is not an IPv4.",
  "input_config": {
    "chain": "Mainnet",
    "root_node_ips": [
      {
        "Ip": "999.0.2.10"
      }
    ]
  },
  "operations": [
    {
      "op": "validate"
    }
  ],
  "expect": {
    "error": {
      "kind": "Invalid",
      "parameter": "root_node_ips[0]",
      "reason_contains": "not an IPv4"
    }
  }
}
