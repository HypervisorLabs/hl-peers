{
  "name": "merge_peers_keep_existing_is_placed_first",
  "description": "Operator-pinned IPs always survive and lead the list.",
  "input_config": {
    "chain": "Mainnet",
    "root_node_ips": [
      {
        "Ip": "192.0.2.10"
      }
    ],
    "try_new_peers": true
  },
  "operations": [
    {
      "op": "merge_peers",
      "args": [
        [
          "203.0.113.1",
          "203.0.113.2"
        ]
      ],
      "opts": {
        "mode": "replace",
        "keep_existing": [
          "192.0.2.10"
        ]
      }
    }
  ],
  "expect": {
    "json_text": "{\n  \"chain\": \"Mainnet\",\n  \"root_node_ips\": [\n    {\n      \"Ip\": \"192.0.2.10\"\n    },\n    {\n      \"Ip\": \"203.0.113.1\"\n    },\n    {\n      \"Ip\": \"203.0.113.2\"\n    }\n  ],\n  \"try_new_peers\": true\n}\n",
    "warnings": []
  }
}
