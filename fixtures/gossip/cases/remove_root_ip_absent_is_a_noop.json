{
  "name": "remove_root_ip_absent_is_a_noop",
  "description": "Removing an absent IP is a no-op.",
  "input_config": {
    "chain": "Mainnet",
    "root_node_ips": [
      {
        "Ip": "192.0.2.10"
      }
    ],
    "try_new_peers": false
  },
  "operations": [
    {
      "op": "remove_root_ip",
      "args": [
        "203.0.113.9"
      ]
    }
  ],
  "expect": {
    "json_text": "{\n  \"chain\": \"Mainnet\",\n  \"root_node_ips\": [\n    {\n      \"Ip\": \"192.0.2.10\"\n    }\n  ],\n  \"try_new_peers\": false\n}\n",
    "warnings": []
  }
}
